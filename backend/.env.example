HOST=127.0.0.1
PORT=4000
DEVICE_ID=gate-01
SCHOOL_SESSION_START=07:00
SCHOOL_SESSION_END=20:00
GATE_DUPLICATE_SECONDS=5
DEVICE_API_KEY=replace_with_a_random_key_at_least_32_characters
DEVICE_RATE_LIMIT_PER_MINUTE=240
# Optional, separate from the entrance scanner. Run npm run scanner:setup.
ADMIN_SCANNER_API_KEY=
# Optional. Blank reports "Not configured"; credentials stay on the server.
DATABASE_URL=
APP_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4000
COOKIE_SECURE=false
# Opt-in: serve frontend/dist from the API server. Build the frontend first.
SERVE_FRONTEND=false
# For LAN browser login, also add the exact server origin to APP_ORIGINS,
# e.g. http://192.168.100.5:4000 (replace with the server's actual LAN address).
